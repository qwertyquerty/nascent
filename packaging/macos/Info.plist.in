<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>@NASCENT_BUNDLE_DISPLAY_NAME@</string>
    <key>CFBundleExecutable</key>
    <string>@NASCENT_BUNDLE_EXECUTABLE@</string>
    <key>CFBundleIconFile</key>
    <string>@NASCENT_BUNDLE_EXECUTABLE@</string>
    <key>CFBundleIdentifier</key>
    <string>@NASCENT_BUNDLE_IDENTIFIER@</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>@NASCENT_BUNDLE_DISPLAY_NAME@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@NASCENT_NUMERIC_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@NASCENT_VERSION@</string>
    <key>LSApplicationCategoryType</key>
    <string>@NASCENT_BUNDLE_CATEGORY@</string>
    <key>LSMinimumSystemVersion</key>
    <string>@CMAKE_OSX_DEPLOYMENT_TARGET@</string>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>

from typing import TypedDict

CALCULATOR_NAME: str
RATE_MIN: float
RATE_MAX: float
RATE_STEP: float
REPLAY_FORMAT_VERSION: int
CHART_HASH_FORMAT: str
PERFORMANCE_ACCURACY_FLOOR: float
HIT_SCORES: list[str]
HIT_SCORE_ACCURACY: dict[str, float]
RANKED_HIT_ACCURACY: int
MAX_HIT_ACCURACY: int
SKILLS: list[str]

class DifficultyBreakdown(TypedDict):
    difficulty: float
    mix: dict[str, float]
    ratings: dict[str, float]
    sustained_seconds: float

class Note:
    def __init__(self, lane: int, time: int, end_time: int | None = None) -> None: ...
    @property
    def lane(self) -> int: ...
    @property
    def time(self) -> int: ...
    @property
    def end_time(self) -> int: ...
    @property
    def is_hold(self) -> bool: ...

class TimingPoint:
    def __init__(self, time: int, bpm: float, meter: int = 4) -> None: ...
    @property
    def time(self) -> int: ...
    @property
    def bpm(self) -> float: ...
    @property
    def beat_length(self) -> float: ...
    @property
    def meter(self) -> int: ...

class Chart:
    @staticmethod
    def from_json(text: str) -> Chart: ...
    @staticmethod
    def create(
        notes: list[Note],
        key_count: int,
        timing_points: list[TimingPoint] = [],
        title: str = "",
        artist: str = "",
        mapper: str = "",
        difficulty_name: str = "",
        audio_file: str = "",
        image_file: str = "",
        preview_time: int = 0,
        hit_accuracy: int = 5,
        damage: int = 5,
    ) -> Chart: ...
    @property
    def notes(self) -> list[Note]: ...
    def notes_at(self, rate: float) -> list[Note]: ...
    @property
    def timing_points(self) -> list[TimingPoint]: ...
    def timing_points_at(self, rate: float) -> list[TimingPoint]: ...
    @property
    def bpm(self) -> float: ...
    @property
    def bpm_min(self) -> float: ...
    @property
    def bpm_max(self) -> float: ...
    @property
    def audio_file(self) -> str: ...
    @property
    def image_file(self) -> str: ...
    @property
    def preview_time(self) -> int: ...
    @property
    def audio_lead_in(self) -> int: ...
    @property
    def hash(self) -> str: ...
    @property
    def key_count(self) -> int: ...
    @property
    def hit_accuracy(self) -> int: ...
    @property
    def damage(self) -> int: ...
    @property
    def title(self) -> str: ...
    @property
    def title_unicode(self) -> str: ...
    @property
    def artist(self) -> str: ...
    @property
    def artist_unicode(self) -> str: ...
    @property
    def mapper(self) -> str: ...
    @property
    def difficulty_name(self) -> str: ...
    @property
    def note_count(self) -> int: ...
    @property
    def hold_count(self) -> int: ...
    @property
    def start_ms(self) -> int: ...
    @property
    def duration_ms(self) -> int: ...
    def end_ms_at(self, rate: float) -> int: ...
    def intro_skip_ms_at(self, rate: float) -> int: ...
    def duration_ms_at(self, rate: float) -> int: ...
    def difficulty(self, rate: float = 1.0) -> float: ...
    def difficulty_breakdown(self, rate: float = 1.0) -> DifficultyBreakdown: ...
    def to_json(self) -> str: ...

class Replay:
    @staticmethod
    def from_json(text: str) -> Replay: ...
    @property
    def version(self) -> int: ...
    @property
    def rate(self) -> float: ...
    @property
    def end_time(self) -> int: ...
    @property
    def key_count(self) -> int: ...
    @property
    def inputs(self) -> list[tuple[int, int, bool]]: ...
    @property
    def settings(self) -> dict[str, int]: ...
    @property
    def claimed_result(self) -> dict[str, object]: ...
    def to_json(self) -> str: ...

class JudgedNote:
    lane: int
    is_hold: bool
    time: int
    end_time: int
    hit_played: bool
    hit_error: int
    hit_score: str
    release_played: bool
    release_error: int
    release_score: str

class Simulation:
    accuracy: float
    grade: str
    max_combo: int
    score_counts: dict[str, int]
    average_error: float
    notes: list[JudgedNote]

class Attempt:
    def __init__(self, chart: Chart, rate: float = 1.0) -> None: ...
    def press(self, lane: int, time: int) -> None: ...
    def release(self, lane: int, time: int) -> None: ...
    def update(self, time: int) -> None: ...
    @property
    def rate(self) -> float: ...
    @property
    def accuracy(self) -> float: ...
    @property
    def combo(self) -> int: ...
    @property
    def max_combo(self) -> int: ...
    @property
    def average_error(self) -> float: ...
    @property
    def error_deviation(self) -> float: ...
    def result(self) -> Simulation: ...
    def replay(self, played_at: str = "") -> Replay: ...

def simulate(chart: Chart, replay: Replay) -> Simulation: ...
def judge(error: int, release: bool = False, hit_accuracy: int = 5) -> str | None: ...
def judgement_windows(hit_accuracy: int = 5, release: bool = False) -> dict[str, int]: ...
def performance(difficulty: float, accuracy: float) -> float: ...
def grade(accuracy: float) -> str: ...
def difficulty_fingerprint() -> str: ...
def convert_osu(text: str) -> str: ...
def convert_osu_entry(text: str) -> dict[str, object]: ...
def convert_stepmania(text: str | bytes) -> list[dict[str, object]]: ...

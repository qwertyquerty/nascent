NASCENT_RELEASE={{ nascent_release }}
NASCENT_DATA_DIR=/opt/nascent/data
NASCENT_POSTGRES_PASSWORD={{ nascent_postgres_password }}
NASCENT_DOMAIN={{ nascent_domain }}
NASCENT_CORS_ORIGINS={{ nascent_cors_origins }}
NASCENT_WORKERS={{ nascent_workers }}
NASCENT_UWSGI_PROCESSES={{ nascent_uwsgi_processes }}
NASCENT_UWSGI_THREADS={{ nascent_uwsgi_threads }}
NASCENT_BACKUP_KEEP_DAYS={{ nascent_backup_keep_days }}
COMPOSE_PROFILES={{ 'db-admin' if db_admin_enabled | bool else '' }}
NASCENT_DB_ADMIN_PORT={{ nascent_db_admin_port }}
NASCENT_DB_ADMIN_EMAIL={{ db_admin_email }}
NASCENT_DB_ADMIN_PASSWORD={{ db_admin_password }}
